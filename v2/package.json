{
  "name": "quire",
  "version": "2.0.0-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run build:assets && bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun run build:assets && bun build --compile --minify --outfile dist/quire src/index.ts",
    "build:assets": "bun scripts/build-assets.ts",
    "test": "bun run build:assets && bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/assets/js",
    "check:filesize": "bun scripts/checks/file-size.ts",
    "check:all": "bun run build:assets && bun run typecheck && bun run check:filesize && bun test",
    "import-v1": "bun scripts/import-v1.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@supabase/postgrest-js": "^2.110.8",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "marked": "18.0.5",
    "nodemailer": "^9.0.3",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "shiki": "4.2.0"
  }
}
